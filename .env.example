# Server Configuration
PORT=5000
NODE_ENV=development

# MQTT Configuration
MQTT_HOST=ef3714cae12549a0ae5abb444c23b670.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_PROTOCOL=mqtts
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password
MQTT_CLIENT_ID=solar_backend_dev

# Firebase Configuration
FIREBASE_PROJECT_ID=solar-panel-iot-xxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@solar-panel-iot-xxxx.iam.gserviceaccount.com
# Use standard RSA private key format, replace \n with actual newlines or double quotes for \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3...\n-----END PRIVATE KEY-----\n"

# Security Configuration
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# ─── Demo Mode Configuration ────────────────────────────────────────────────
# Set DEMO_MODE=true  → Backend uses Dummy Telemetry (no ESP/MQTT required)
# Set DEMO_MODE=false → Backend uses real MQTT/HiveMQ (requires ESP)
# Switch between modes without recompiling. Flutter does not need to change.
DEMO_MODE=false

# Simulation Time & Range Controls (used when DEMO_MODE=true)
SIMULATION_TIME_MODE=REAL_TIME  # REAL_TIME | FIXED | ACCELERATED
SIMULATION_START_TIME=11:00
SIMULATION_END_TIME=13:00
SIMULATION_TIME=11:45           # Optional override for fixed time demo
SIMULATION_SPEED=1              # 1 = real speed, 10 = 10x speed
TEMPERATURE_MIN=40
TEMPERATURE_MAX=60

# Cleaning simulation duration in milliseconds (only used when DEMO_MODE=true)
DEMO_CLEANING_DURATION_MS=10000
